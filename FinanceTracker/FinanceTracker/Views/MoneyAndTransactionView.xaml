<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceTracker.Views.MoneyAndTransactionView">
    <Grid RowDefinitions="Auto, *" ColumnDefinitions="5*, *">
        <Label Text="{Binding Balance, StringFormat='Balance: {0}'}" Grid.Row="0"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="TransactionHistoryHolder"/>
        </ScrollView>
        <ScrollView Grid.Row="1" Grid.Column="1">
            <VerticalStackLayout x:Name="GoalHolder" Grid.Column="1"/>
        </ScrollView>
    </Grid>
</ContentView>