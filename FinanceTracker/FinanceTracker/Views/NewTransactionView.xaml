<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceTracker.Views.NewTransactionView">
    <Grid RowDefinitions="*, *, *" ColumnDefinitions="*, 2*">
        
        <Label Text="Amount"/>
        <Entry Grid.Column="1" x:Name="amount"/>

        <Label Text="Description" Grid.Row="1"/>
        <Entry Grid.Column="1" Grid.Row="1" x:Name="desc"/>

        <Label Text="Withdrawing or Depositing" Grid.Row="2"/>
        <HorizontalStackLayout Grid.Column="1" Grid.Row="2">
            <Button Text="Withdraw" Clicked="WithdrawButton_Clicked"/>
            <Button Text="Deposit" Clicked="DepositButton_Clicked"/>
        </HorizontalStackLayout>
        
    </Grid>
</ContentView>
