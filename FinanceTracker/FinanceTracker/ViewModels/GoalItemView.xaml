<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinanceTracker.ViewModels.GoalItemView">
    <Grid ColumnDefinitions="150, 100, 100, 100, 100" Padding="10, 10, 10, 10" Margin="10, 10, 10, 10">
        <VerticalStackLayout Grid.Column="0">
            <Label Text="Goal Description"/>
            <Label Text="{Binding GoalDesc}"/>

        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1">
            <Label Text="Interval"/>
            <Label Text="{Binding DayTimeInterval}"/>

        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="2">
            <Label Text="Amount"/>
            <Label Text="{Binding AmountToChange}"/>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="3">
            <Label Text="Completed"/>
            <CheckBox IsChecked="{Binding GoalReached}"/>
        </VerticalStackLayout>
        <Button Text="Delete" Grid.Column="4" Clicked="DeleteButton_Clicked"/>
    </Grid>
</ContentView>
